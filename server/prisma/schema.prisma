generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  STAFF
  ORG_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
  MATCH
  FILL_IN_BLANK
  FILL_BLANK
}

enum QuestionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResultReleaseMode {
  IMMEDIATE
  MANUAL
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum PracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum MediaType {
  VIDEO
  AUDIO
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MediaVisibility {
  DRAFT
  PUBLISHED
}

enum MediaJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model Organization {
  id                       String               @id @default(cuid())
  name                     String
  code                     String?              @unique
  headName                 String
  contactNumber            String
  email                    String               @unique
  address                  String
  city                     String
  state                    String
  country                  String
  registrationNumber       String?
  website                  String?
  status                   OrganizationStatus   @default(PENDING)
  isPlatformOwner          Boolean              @default(false)
  rejectionReason          String?
  pendingAdminPasswordHash String?
  approvedById             String?
  approvedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  approvedBy               User?                @relation("OrganizationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  users                    User[]
  studentProfiles          StudentProfile[]
  staffProfiles            StaffProfile[]
  accountApprovals         AccountApproval[]
  sessions                 Session[]
  loginLogs                LoginLog[]
  auditLogs                AuditLog[]
  batches                  Batch[]
  courses                  Course[]
  courseInstructors        CourseInstructor[]
  enrollments              Enrollment[]
  courseTopics             CourseTopic[]
  assessments              Assessment[]
  assessmentQuestions      AssessmentQuestion[]
  practiceQuestions        PracticeQuestion[]
  assessmentAttempts      AssessmentAttempt[]
  assessmentAttemptAnswers AssessmentAttemptAnswer[]
  assessmentAttemptEvents AssessmentAttemptEvent[]
  practiceSessions        PracticeSession[]
  practiceSessionAnswers  PracticeSessionAnswer[]
  notes                    Note[]
  noteViews                NoteView[]
  mediaItems               MediaItem[]
  mediaJobs                MediaJob[]
  watchProgress            WatchProgress[]
  expertSessions           ExpertSession[]
  batchStudents            BatchStudent[]
  batchInstructors         BatchInstructor[]

  @@index([status, createdAt])
}

model User {
  id                       String             @id @default(cuid())
  organizationId           String?
  email                    String
  passwordHash             String
  name                     String
  phone                    String?
  role                     Role
  status                   AccountStatus      @default(PENDING)
  rejectionReason          String?
  mustChangePassword       Boolean            @default(false)
  isActive                 Boolean            @default(true)
  approvedById             String?
  approvedAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  organization             Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile           StudentProfile?
  staffProfile             StaffProfile?
  sessions                 Session[]
  loginLogs                LoginLog[]
  approvedProfiles         StudentProfile[]   @relation("ProfileApprover")
  accountApprovals         AccountApproval[]  @relation("AccountApprover")
  accountRegistration      AccountApproval?   @relation("AccountRegistration")
  approvedAccounts         User[]             @relation("UserApprover")
  approvedBy               User?              @relation("UserApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedOrganizations    Organization[]     @relation("OrganizationApprover")
  studentBatches           BatchStudent[]
  instructorBatches        BatchInstructor[]
  auditLogs                AuditLog[]         @relation("AuditActor")
  courses                  Course[]           @relation("CourseCreator")
  instructedCourses        CourseInstructor[]
  enrollments              Enrollment[]       @relation("StudentCourseEnrollments")
  createdAssessments       Assessment[]       @relation("AssessmentCreator")
  createdPracticeQuestions PracticeQuestion[] @relation("PracticeQuestionCreator")
  notes                    Note[]             @relation("NoteAuthor")
  uploadedMedia            MediaItem[]        @relation("MediaUploader")
  watchProgress            WatchProgress[]    @relation("WatchProgressStudent")
  noteViews                NoteView[]
  hostedExpertSessions     ExpertSession[]    @relation("ExpertSessionHost")
  assessmentAttempts       AssessmentAttempt[] @relation("AssessmentAttemptStudent")
  practiceSessions         PracticeSession[]   @relation("PracticeSessionStudent")

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId, role, status])
}

model StudentProfile {
  id              String        @id @default(cuid())
  organizationId  String
  userId          String        @unique
  studentId       String
  status          StudentStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("ProfileApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, studentId])
  @@index([organizationId, status, createdAt])
}

model StaffProfile {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @unique
  staffId        String
  joiningDate    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffId])
  @@index([organizationId, joiningDate])
}

model AccountApproval {
  id              String        @id @default(cuid())
  organizationId  String
  userId          String        @unique
  status          StudentStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation("AccountRegistration", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("AccountApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

model Batch {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       BatchStudent[]
  instructors    BatchInstructor[]
  expertSessions ExpertSession[]

  @@unique([organizationId, name])
}

model BatchStudent {
  organizationId String
  batchId        String
  studentId      String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([organizationId, batchId, studentId])
  @@index([organizationId, studentId])
}

model BatchInstructor {
  organizationId String
  batchId        String
  instructorId   String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor     User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([organizationId, batchId, instructorId])
  @@index([organizationId, instructorId])
}

model Session {
  id               String        @id @default(cuid())
  organizationId   String?
  userId           String
  refreshTokenHash String
  ip               String?
  userAgent        String?
  createdAt        DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, revokedAt, expiresAt])
}

model LoginLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  ip             String?
  userAgent      String?
  success        Boolean
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType, targetId, createdAt])
}

model Course {
  id                       String             @id @default(cuid())
  organizationId           String
  code                     String
  title                    String
  description              String?
  category                 String
  plannedHours             Int
  startDate                DateTime           @db.Date
  endDate                  DateTime           @db.Date
  status                   CourseStatus       @default(DRAFT)
  minimumAttendancePercent Int                @default(75)
  requiresAssessmentPass   Boolean            @default(true)
  createdById              String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                User               @relation("CourseCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  instructors              CourseInstructor[]
  topics                   CourseTopic[]
  enrollments              Enrollment[]
  notes                    Note[]
  mediaItems               MediaItem[]
  assessments              Assessment[]
  practiceQuestions        PracticeQuestion[]
  practiceSessions         PracticeSession[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, createdById, status, updatedAt])
}

model CourseInstructor {
  organizationId String
  courseId       String
  instructorId   String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  instructor     User         @relation(fields: [organizationId, instructorId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, courseId, instructorId])
  @@index([organizationId, instructorId, courseId])
}

model CourseTopic {
  id                String             @id @default(cuid())
  organizationId    String
  courseId          String
  title             String
  plannedHours      Int
  order             Int
  covered           Boolean            @default(false)
  coveredAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  practiceQuestions PracticeQuestion[]
  mediaItems        MediaItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, courseId, order])
  @@index([organizationId, courseId, order])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  courseId       String
  studentId      String
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  student        User             @relation("StudentCourseEnrollments", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, courseId, studentId])
  @@index([organizationId, studentId, status, enrolledAt])
  @@index([organizationId, courseId, status, enrolledAt])
}

model Assessment {
  id              String               @id @default(cuid())
  organizationId  String
  courseId        String
  createdById     String
  title           String
  instructions    String
  totalMarks      Int
  passMark        Int
  durationMinutes Int
  opensAt         DateTime?
  closesAt        DateTime?
  maxAttempts     Int                  @default(1)
  shuffleQuestions Boolean             @default(false)
  shuffleOptions  Boolean              @default(false)
  resultReleaseMode ResultReleaseMode  @default(IMMEDIATE)
  answerReviewAllowed Boolean           @default(true)
  weight          Float?
  publishedSnapshot Json?
  resultsReleasedAt DateTime?
  status          AssessmentStatus     @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@unique([organizationId, id])
  @@index([organizationId, courseId, status])
}

model AssessmentQuestion {
  id             String       @id @default(cuid())
  organizationId String
  assessmentId   String
  type           QuestionType
  prompt         String
  options        Json?
  correctAnswer  Json
  marks          Int
  explanation    String?
  topic          String                @default("")
  topicId        String?
  difficulty     QuestionDifficulty @default(BEGINNER)
  sourceQuestionId String?
  order          Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     Assessment   @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, assessmentId, order])
  @@index([organizationId, assessmentId])
}

model PracticeQuestion {
  id             String             @id @default(cuid())
  organizationId String
  courseId       String
  topicId        String?
  createdById    String
  type           QuestionType
  prompt         String
  options        Json?
  correctAnswer  Json
  topic          String
  difficulty     QuestionDifficulty
  explanation    String?
  marks          Int                @default(1)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  courseTopic    CourseTopic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdBy      User               @relation("PracticeQuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, courseId, type, topic])
}

model AssessmentAttempt {
  id              String                  @id @default(cuid())
  organizationId  String
  assessmentId    String
  studentId       String
  activeKey       String?
  status          AssessmentAttemptStatus @default(IN_PROGRESS)
  snapshot        Json
  startedAt       DateTime                @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  score           Float?
  percentage      Float?
  passed           Boolean?
  flagged          Boolean               @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment       Assessment             @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Cascade)
  student          User                   @relation("AssessmentAttemptStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  answers          AssessmentAttemptAnswer[]
  events           AssessmentAttemptEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, studentId, activeKey])
  @@index([organizationId, studentId, status, startedAt])
  @@index([organizationId, assessmentId, status, submittedAt])
}

model AssessmentAttemptAnswer {
  id              String            @id @default(cuid())
  organizationId  String
  attemptId       String
  questionId      String
  answer          Json
  score           Float?
  answeredAt      DateTime          @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempt         AssessmentAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, attemptId, questionId])
  @@index([organizationId, attemptId])
}

model AssessmentAttemptEvent {
  id              String            @id @default(cuid())
  organizationId  String
  attemptId       String
  eventType       String
  details         Json?
  createdAt       DateTime          @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempt         AssessmentAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, attemptId, createdAt])
}

model PracticeSession {
  id              String                @id @default(cuid())
  organizationId  String
  studentId       String
  courseId        String
  questionIds     Json
  totalQuestions  Int
  answeredCount   Int                   @default(0)
  score           Float                 @default(0)
  timeLimitSeconds Int?
  expiresAt       DateTime?
  status          PracticeSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         User                  @relation("PracticeSessionStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  course          Course                @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  answers         PracticeSessionAnswer[]

  @@unique([organizationId, id])
  @@index([organizationId, studentId, createdAt])
}

model PracticeSessionAnswer {
  id              String          @id @default(cuid())
  organizationId  String
  sessionId       String
  questionId      String
  answer          Json
  isCorrect       Boolean
  score           Float
  answeredAt      DateTime        @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session         PracticeSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, sessionId, questionId])
  @@index([organizationId, sessionId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  authorId       String
  title          String
  subject        String
  description    String
  storageKey     String?
  originalName   String?
  mimeType       String?
  published      Boolean      @default(false)
  courseId       String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  views          NoteView[]
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([organizationId, published, updatedAt])
  @@index([organizationId, courseId])
}

model NoteView {
  id             String       @id @default(cuid())
  organizationId String
  noteId         String
  userId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  note           Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, noteId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model MediaItem {
  id              String          @id @default(cuid())
  organizationId  String
  courseId        String
  topicId         String?
  title           String
  description     String?         @db.Text
  type            MediaType
  status          MediaStatus     @default(UPLOADING)
  visibility      MediaVisibility @default(DRAFT)
  durationSeconds Int?
  sizeBytes       BigInt          @default(0)
  storageBytes    BigInt          @default(0)
  originalKey     String?
  streamKey       String?
  thumbnailKey    String?
  uploadedById    String
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course          @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  topic           CourseTopic?    @relation(fields: [organizationId, topicId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy      User            @relation("MediaUploader", fields: [organizationId, uploadedById], references: [organizationId, id], onDelete: Restrict)
  job             MediaJob?
  watchProgress   WatchProgress[]

  @@unique([organizationId, id])
  @@index([organizationId, deletedAt, status, createdAt])
  @@index([organizationId, courseId, type, status])
  @@index([organizationId, uploadedById, createdAt])
}

model MediaJob {
  id              String         @id @default(cuid())
  organizationId  String
  mediaId         String
  status          MediaJobStatus @default(QUEUED)
  attempts        Int            @default(0)
  progressPercent Int            @default(0)
  error           String?        @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  availableAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media           MediaItem      @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, mediaId])
  @@index([status, availableAt, createdAt])
  @@index([organizationId, status, availableAt])
}

model WatchProgress {
  id                  String       @id @default(cuid())
  organizationId      String
  studentId           String
  mediaId             String
  lastPositionSeconds Float        @default(0)
  watchedSeconds      Float        @default(0)
  completed           Boolean      @default(false)
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student             User         @relation("WatchProgressStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  media               MediaItem    @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, studentId, mediaId])
  @@index([organizationId, mediaId, completed])
}

model ExpertSession {
  id              String       @id @default(cuid())
  organizationId  String
  hostId          String
  batchId         String?
  title           String
  description     String
  startsAt        DateTime
  durationMinutes Int
  roomName        String       @unique
  audienceType    String       @default("ALL")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host            User         @relation("ExpertSessionHost", fields: [hostId], references: [id], onDelete: Restrict)
  batch           Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
}
