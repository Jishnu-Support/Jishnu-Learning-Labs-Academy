generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  ORG_ADMIN
  SUPER_ADMIN
}

enum NotificationType {
  CONTENT_PUBLISHED
  SESSION_SCHEDULED
  SESSION_REMINDER
  ASSESSMENT_PUBLISHED
  ASSESSMENT_CLOSING
  ASSESSMENT_RESULTS
  ACCOUNT_PENDING
  ACCOUNT_STATUS
  REQUEST_STATUS
  PAYMENT_STATUS
  SUBSCRIPTION_STATUS
  CERTIFICATE_ISSUED
  ATTENDANCE_ALERT
  CLASS_BOOKED
  PAYOUT_RECORDED
  SYSTEM
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  PENDING_PAYMENT
}

enum RegistrationPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum RegistrationPaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
}

enum OrganizationStatus {
  ACTIVE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
  MATCH
  FILL_IN_BLANK
  FILL_BLANK
}

enum QuestionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResultReleaseMode {
  IMMEDIATE
  MANUAL
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum PracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum MediaType {
  VIDEO
  AUDIO
}

enum MediaSource {
  UPLOAD
  YOUTUBE
}

enum MediaStatus {
  UPLOADING
  AWAITING_FILE
  PROCESSING
  READY
  FAILED
}

enum MediaVisibility {
  DRAFT
  PUBLISHED
}

enum MediaJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ExpertSessionStatus {
  SCHEDULED
  LIVE
  CANCELLED
  COMPLETED
}

enum AttendanceMark {
  PRESENT
  LATE
  ABSENT
}

enum LibraryKind {
  BOOK
  DOCUMENT
  NOTE
  LINK
}

enum SubscriptionPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderKind {
  MOCK
  RAZORPAY
}

model Organization {
  id                       String                    @id @default(cuid())
  name                     String
  code                     String?                   @unique
  headName                 String
  contactNumber            String
  email                    String                    @unique
  address                  String
  city                     String
  state                    String
  country                  String
  registrationNumber       String?
  website                  String?
  status                   OrganizationStatus        @default(PENDING)
  isPlatformOwner          Boolean                   @default(false)
  rejectionReason          String?
  pendingAdminPasswordHash String?
  paymentsEnabled          Boolean                   @default(false)
  ratingRequiresActivity   Boolean                   @default(true)
  currency                 String                    @default("INR")
  minimumMonthlyFee        Decimal?                  @db.Decimal(12, 2)
  maximumMonthlyFee        Decimal?                  @db.Decimal(12, 2)
  minimumQuarterlyFee      Decimal?                  @db.Decimal(12, 2)
  maximumQuarterlyFee      Decimal?                  @db.Decimal(12, 2)
  minimumYearlyFee         Decimal?                  @db.Decimal(12, 2)
  maximumYearlyFee         Decimal?                  @db.Decimal(12, 2)
  invoiceName              String?
  invoiceAddress           String?
  invoiceTaxId             String?
  approvedById             String?
  approvedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  approvedBy               User?                     @relation("OrganizationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  users                    User[]
  studentProfiles          StudentProfile[]
  tutorProfiles            TutorProfile[]
  accountApprovals         AccountApproval[]
  sessions                 Session[]
  loginLogs                LoginLog[]
  auditLogs                AuditLog[]
  batches                  Batch[]
  courses                  Course[]
  courseInstructors        CourseInstructor[]
  enrollments              Enrollment[]
  courseTopics             CourseTopic[]
  assessments              Assessment[]
  assessmentQuestions      AssessmentQuestion[]
  practiceQuestions        PracticeQuestion[]
  practiceSets             PracticeSet[]
  assessmentAttempts       AssessmentAttempt[]
  assessmentAttemptAnswers AssessmentAttemptAnswer[]
  assessmentAttemptEvents  AssessmentAttemptEvent[]
  practiceSessions         PracticeSession[]
  practiceSessionAnswers   PracticeSessionAnswer[]
  notes                    Note[]
  noteViews                NoteView[]
  mediaItems               MediaItem[]
  mediaJobs                MediaJob[]
  watchProgress            WatchProgress[]
  expertSessions           ExpertSession[]
  batchStudents            BatchStudent[]
  batchInstructors         BatchInstructor[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  attendanceRecords        AttendanceRecord[]
  libraryItems             LibraryItem[]
  savedLibraryItems        SavedLibraryItem[]
  savedNotes               SavedNote[]
  tutorReviews             TutorReview[]
  certificates             Certificate[]
  gameRatings              GameRating[]
  tutorCoursePlans         TutorCoursePlan[]
  subscriptions            Subscription[]
  payments                 Payment[]
  registrationPayments    RegistrationPayment[]
  paymentPlanPriceHistory  TutorCoursePlanHistory[]
  jobOpenings              JobOpening[]
  jobApplications          JobApplication[]

  @@index([status, createdAt])
}

model User {
  id                       String                   @id @default(cuid())
  organizationId           String?
  email                    String
  passwordHash             String
  name                     String
  phone                    String?
  role                     Role
  status                   AccountStatus            @default(PENDING)
  rejectionReason          String?
  mustChangePassword       Boolean                  @default(false)
  isActive                 Boolean                  @default(true)
  approvedById             String?
  approvedAt               DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  organization             Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile           StudentProfile?
  tutorProfile             TutorProfile?
  sessions                 Session[]
  loginLogs                LoginLog[]
  approvedProfiles         StudentProfile[]         @relation("ProfileApprover")
  accountApprovals         AccountApproval[]        @relation("AccountApprover")
  accountRegistration      AccountApproval?         @relation("AccountRegistration")
  approvedAccounts         User[]                   @relation("UserApprover")
  approvedBy               User?                    @relation("UserApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedOrganizations    Organization[]           @relation("OrganizationApprover")
  studentBatches           BatchStudent[]
  instructorBatches        BatchInstructor[]
  auditLogs                AuditLog[]               @relation("AuditActor")
  courses                  Course[]                 @relation("CourseCreator")
  platformCreatedCourses   Course[]                 @relation("PlatformCourseCreator")
  instructedCourses        CourseInstructor[]
  enrollments              Enrollment[]             @relation("StudentCourseEnrollments")
  createdAssessments       Assessment[]             @relation("AssessmentCreator")
  createdPracticeQuestions PracticeQuestion[]       @relation("PracticeQuestionCreator")
  createdPracticeSets      PracticeSet[]            @relation("PracticeSetCreator")
  notes                    Note[]                   @relation("NoteAuthor")
  uploadedMedia            MediaItem[]              @relation("MediaUploader")
  platformUploadedMedia    MediaItem[]              @relation("PlatformMediaUploader")
  createdJobOpenings       JobOpening[]             @relation("JobOpeningCreator")
  jobApplications          JobApplication[]         @relation("JobApplicationStudent")
  watchProgress            WatchProgress[]          @relation("WatchProgressStudent")
  noteViews                NoteView[]
  hostedExpertSessions     ExpertSession[]          @relation("ExpertSessionHost")
  assessmentAttempts       AssessmentAttempt[]      @relation("AssessmentAttemptStudent")
  practiceSessions         PracticeSession[]        @relation("PracticeSessionStudent")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  attendanceRecords        AttendanceRecord[]       @relation("AttendanceStudent")
  markedAttendance         AttendanceRecord[]       @relation("AttendanceMarker")
  libraryItems             LibraryItem[]            @relation("LibraryCreator")
  savedLibraryItems        SavedLibraryItem[]
  savedNotes               SavedNote[]
  certificates             Certificate[]            @relation("CertificateStudent")
  issuedCertificates       Certificate[]            @relation("CertificateIssuer")
  gameRatings              GameRating[]
  tutorCoursePlans         TutorCoursePlan[]        @relation("TutorCoursePlanTutor")
  changedPaymentPlanPrices TutorCoursePlanHistory[] @relation("PaymentPlanPriceChanger")
  studentSubscriptions     Subscription[]           @relation("SubscriptionStudent")
  tutorSubscriptions       Subscription[]           @relation("SubscriptionTutor")
  studentPayments          Payment[]                @relation("PaymentStudent")
  tutorPayments            Payment[]                @relation("PaymentTutor")
  registrationPayment      RegistrationPayment?    @relation("RegistrationPaymentApplicant")
  preferredByStudents      StudentProfile[]         @relation("StudentPreferredTutor")
  tutorReviewsWritten      TutorReview[]            @relation("TutorReviewStudent")
  tutorReviewsReceived     TutorReview[]            @relation("TutorReviewTutor")
  selectedTutorEnrollments Enrollment[]             @relation("EnrollmentSelectedTutor")
  pendingTutorEnrollments  Enrollment[]             @relation("EnrollmentPendingTutor")

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId, role, status])
}

model StudentProfile {
  id                     String        @id @default(cuid())
  organizationId         String
  userId                 String        @unique
  studentId              String
  fatherName             String?
  motherName             String?
  currentEducation       String?
  educationLevel         String?
  educationYear          String?
  currentCourse          String?
  institutionName        String?
  profilePhotoStorageKey String?
  aadhaarEncrypted       String?
  aadhaarLast4           String?
  apaarIdEncrypted       String?
  apaarIdLast4           String?
  piiConsentAt           DateTime?
  interestedCourse       String?
  termsAcceptedAt        DateTime?
  isDemoIdentityData     Boolean       @default(false)
  selectedTutorId        String?
  status                 StudentStatus @default(PENDING)
  rejectionReason        String?
  approvedById           String?
  approvedAt             DateTime?
  createdAt              DateTime      @default(now())
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy             User?         @relation("ProfileApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  selectedTutor          User?         @relation("StudentPreferredTutor", fields: [organizationId, selectedTutorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, studentId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, selectedTutorId])
}

model RegistrationPayment {
  id                    String                     @id @default(cuid())
  organizationId        String
  applicantId           String                     @map("studentId")
  applicantRole         Role                       @default(STUDENT)
  courseId              String
  amount                Decimal                    @db.Decimal(12, 2)
  currency              String                     @default("INR")
  status                RegistrationPaymentStatus  @default(PENDING)
  paymentMethod         RegistrationPaymentMethod?
  transactionReference  String?                    @db.VarChar(120)
  receiptStorageKey     String?
  receiptOriginalName   String?
  reportedPaid          Boolean                    @default(false)
  statusTokenHash       String                     @unique(map: "RegistrationPayment_statusTokenHash_key")
  paidAt                DateTime?
  refundedAt            DateTime?
  refundReason          String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicant             User                       @relation("RegistrationPaymentApplicant", fields: [organizationId, applicantId], references: [organizationId, id], onDelete: Restrict, map: "RegistrationPayment_organizationId_studentId_fkey")
  course                Course                     @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, applicantId], map: "RegistrationPayment_organizationId_studentId_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, applicantRole, status, createdAt])
}

model TutorReview {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  tutorId        String
  rating         Int
  review         String?      @db.VarChar(2000)
  courseId       String?
  hiddenAt       DateTime?
  hiddenReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        User         @relation("TutorReviewStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  tutor          User         @relation("TutorReviewTutor", fields: [organizationId, tutorId], references: [organizationId, id], onDelete: Cascade)
  course         Course?      @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, studentId, tutorId, courseId])
  @@index([organizationId, tutorId, createdAt])
  @@index([organizationId, courseId, createdAt])
}

model TutorProfile {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String       @unique
  tutorId         String
  acceptsNewFees  Boolean      @default(true)
  joiningDate     DateTime     @default(now())
  bio             String?
  expertise       String[]     @default([])
  photoStorageKey String?
  resumeStorageKey String?
  resumeOriginalName String?
  fatherName      String?
  motherName      String?
  interestedCourse String?
  aadhaarEncrypted String?
  aadhaarLast4    String?
  apaarIdEncrypted String?
  apaarIdLast4    String?
  piiConsentAt    DateTime?
  termsAcceptedAt DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tutorId])
  @@index([organizationId, joiningDate])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String
  type           NotificationType
  courseId       String?
  title          String
  body           String
  link           String?
  groupKey       String?
  groupCount     Int              @default(1)
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, userId, readAt, createdAt])
  @@index([organizationId, userId, groupKey, createdAt])
  @@index([organizationId, courseId, createdAt])
}

model NotificationPreference {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String
  category       String
  enabled        Boolean       @default(true)
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, category])
  @@index([organizationId, userId])
}

model NotificationSchedulerLock {
  name        String   @id
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model AccountApproval {
  id              String        @id @default(cuid())
  organizationId  String
  userId          String        @unique
  status          StudentStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation("AccountRegistration", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("AccountApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

model Batch {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       BatchStudent[]
  instructors    BatchInstructor[]
  expertSessions ExpertSession[]

  @@unique([organizationId, name])
}

model BatchStudent {
  organizationId String
  batchId        String
  studentId      String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([organizationId, batchId, studentId])
  @@index([organizationId, studentId])
}

model BatchInstructor {
  organizationId String
  batchId        String
  instructorId   String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor     User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([organizationId, batchId, instructorId])
  @@index([organizationId, instructorId])
}

model Session {
  id               String        @id @default(cuid())
  organizationId   String?
  userId           String
  refreshTokenHash String
  ip               String?
  userAgent        String?
  createdAt        DateTime      @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, revokedAt, expiresAt])
}

model LoginLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  ip             String?
  userAgent      String?
  success        Boolean
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType, targetId, createdAt])
}

model Course {
  id                       String             @id @default(cuid())
  organizationId           String
  code                     String
  title                    String
  description              String?
  thumbnailUrl             String?
  category                 String
  plannedHours             Int
  registrationMonthlyFee   Decimal?           @db.Decimal(12, 2)
  startDate                DateTime           @db.Date
  endDate                  DateTime           @db.Date
  status                   CourseStatus       @default(DRAFT)
  minimumAttendancePercent Int                @default(75)
  requiresAssessmentPass   Boolean            @default(true)
  createdById              String?
  createdBySuperAdminId    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                User?              @relation("CourseCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  createdBySuperAdmin      User?              @relation("PlatformCourseCreator", fields: [createdBySuperAdminId], references: [id], onDelete: SetNull)
  instructors              CourseInstructor[]
  topics                   CourseTopic[]
  enrollments              Enrollment[]
  notes                    Note[]
  mediaItems               MediaItem[]
  assessments              Assessment[]
  practiceQuestions        PracticeQuestion[]
  practiceSets             PracticeSet[]
  practiceSessions         PracticeSession[]
  expertSessions           ExpertSession[]
  libraryItems             LibraryItem[]
  attendanceRecords        AttendanceRecord[]
  certificates             Certificate[]
  tutorCoursePlans         TutorCoursePlan[]
  subscriptions            Subscription[]
  payments                 Payment[]
  registrationPayments     RegistrationPayment[]
  tutorReviews             TutorReview[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, createdById, status, updatedAt])
}

model CourseInstructor {
  organizationId String
  courseId       String
  instructorId   String
  assignedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  instructor     User         @relation(fields: [organizationId, instructorId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, courseId, instructorId])
  @@index([organizationId, instructorId, courseId])
}

model CourseTopic {
  id                String             @id @default(cuid())
  organizationId    String
  courseId          String
  title             String
  plannedHours      Int
  order             Int
  covered           Boolean            @default(false)
  coveredAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  practiceQuestions PracticeQuestion[]
  mediaItems        MediaItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, courseId, order])
  @@index([organizationId, courseId, order])
}

model Enrollment {
  id              String           @id @default(cuid())
  organizationId  String
  courseId        String
  studentId       String
  status          EnrollmentStatus @default(ACTIVE)
  selectedTutorId String?
  pendingTutorId  String?
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  student         User             @relation("StudentCourseEnrollments", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  selectedTutor   User?            @relation("EnrollmentSelectedTutor", fields: [organizationId, selectedTutorId], references: [organizationId, id], onDelete: Restrict)
  pendingTutor    User?            @relation("EnrollmentPendingTutor", fields: [organizationId, pendingTutorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, courseId, studentId])
  @@index([organizationId, studentId, status, enrolledAt])
  @@index([organizationId, courseId, status, enrolledAt])
}

model Assessment {
  id                  String               @id @default(cuid())
  organizationId      String
  courseId            String
  createdById         String
  title               String
  instructions        String
  totalMarks          Int
  passMark            Int
  durationMinutes     Int
  opensAt             DateTime?
  closesAt            DateTime?
  maxAttempts         Int                  @default(1)
  shuffleQuestions    Boolean              @default(false)
  shuffleOptions      Boolean              @default(false)
  resultReleaseMode   ResultReleaseMode    @default(IMMEDIATE)
  answerReviewAllowed Boolean              @default(true)
  weight              Float?
  publishedSnapshot   Json?
  resultsReleasedAt   DateTime?
  status              AssessmentStatus     @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions           AssessmentQuestion[]
  attempts            AssessmentAttempt[]

  @@unique([organizationId, id])
  @@index([organizationId, courseId, status])
}

model AssessmentQuestion {
  id               String             @id @default(cuid())
  organizationId   String
  assessmentId     String
  type             QuestionType
  prompt           String
  options          Json?
  correctAnswer    Json
  marks            Int
  explanation      String?
  topic            String             @default("")
  topicId          String?
  difficulty       QuestionDifficulty @default(BEGINNER)
  sourceQuestionId String?
  order            Int
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment       Assessment         @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, assessmentId, order])
  @@index([organizationId, assessmentId])
}

model PracticeQuestion {
  id             String             @id @default(cuid())
  organizationId String
  courseId       String
  topicId        String?
  createdById    String
  type           QuestionType
  prompt         String
  options        Json?
  correctAnswer  Json
  topic          String
  difficulty     QuestionDifficulty
  explanation    String?
  marks          Int                @default(1)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  courseTopic    CourseTopic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdBy      User               @relation("PracticeQuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, courseId, type, topic])
}

model PracticeSet {
  id             String             @id @default(cuid())
  organizationId String
  courseId       String
  createdById    String
  title          String
  topic          String
  difficulty     QuestionDifficulty
  questionIds    Json
  published      Boolean            @default(false)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  createdBy      User               @relation("PracticeSetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sessions       PracticeSession[]

  @@unique([organizationId, id])
  @@index([organizationId, courseId, published, updatedAt])
}

model AssessmentAttempt {
  id             String                    @id @default(cuid())
  organizationId String
  assessmentId   String
  studentId      String
  activeKey      String?
  status         AssessmentAttemptStatus   @default(IN_PROGRESS)
  snapshot       Json
  startedAt      DateTime                  @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  score          Float?
  percentage     Float?
  passed         Boolean?
  flagged        Boolean                   @default(false)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     Assessment                @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Cascade)
  student        User                      @relation("AssessmentAttemptStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  answers        AssessmentAttemptAnswer[]
  events         AssessmentAttemptEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, studentId, activeKey])
  @@index([organizationId, studentId, status, startedAt])
  @@index([organizationId, assessmentId, status, submittedAt])
}

model AssessmentAttemptAnswer {
  id             String            @id @default(cuid())
  organizationId String
  attemptId      String
  questionId     String
  answer         Json
  score          Float?
  answeredAt     DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempt        AssessmentAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, attemptId, questionId])
  @@index([organizationId, attemptId])
}

model AssessmentAttemptEvent {
  id             String            @id @default(cuid())
  organizationId String
  attemptId      String
  eventType      String
  details        Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempt        AssessmentAttempt @relation(fields: [organizationId, attemptId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, attemptId, createdAt])
}

model PracticeSession {
  id               String                  @id @default(cuid())
  organizationId   String
  studentId        String
  courseId         String
  practiceSetId    String?
  questionIds      Json
  totalQuestions   Int
  answeredCount    Int                     @default(0)
  score            Float                   @default(0)
  timeLimitSeconds Int?
  expiresAt        DateTime?
  status           PracticeSessionStatus   @default(IN_PROGRESS)
  startedAt        DateTime                @default(now())
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student          User                    @relation("PracticeSessionStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  course           Course                  @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  practiceSet      PracticeSet?            @relation(fields: [organizationId, practiceSetId], references: [organizationId, id], onDelete: Restrict)
  answers          PracticeSessionAnswer[]

  @@unique([organizationId, id])
  @@index([organizationId, studentId, createdAt])
}

model PracticeSessionAnswer {
  id             String          @id @default(cuid())
  organizationId String
  sessionId      String
  questionId     String
  answer         Json
  isCorrect      Boolean
  score          Float
  answeredAt     DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        PracticeSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, sessionId, questionId])
  @@index([organizationId, sessionId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  authorId       String
  title          String
  subject        String
  description    String
  storageKey     String?
  originalName   String?
  mimeType       String?
  published      Boolean      @default(false)
  freePreview    Boolean      @default(false)
  courseId       String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  views          NoteView[]
  savedBy        SavedNote[]
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, published, updatedAt])
  @@index([organizationId, courseId])
}

model SavedNote {
  organizationId String
  noteId         String
  studentId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  note           Note         @relation(fields: [organizationId, noteId], references: [organizationId, id], onDelete: Cascade)
  student        User         @relation(fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, noteId, studentId])
  @@index([organizationId, studentId, createdAt])
}

model NoteView {
  id             String       @id @default(cuid())
  organizationId String
  noteId         String
  userId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  note           Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, noteId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model MediaItem {
  id              String          @id @default(cuid())
  organizationId  String
  courseId        String
  topicId         String?
  title           String
  description     String?         @db.Text
  type            MediaType
  source          MediaSource     @default(UPLOAD)
  youtubeVideoId  String?         @db.VarChar(11)
  status          MediaStatus     @default(UPLOADING)
  visibility      MediaVisibility @default(DRAFT)
  freePreview     Boolean         @default(false)
  durationSeconds Int?
  sizeBytes       BigInt          @default(0)
  storageBytes    BigInt          @default(0)
  originalKey     String?
  streamKey       String?
  thumbnailKey    String?
  publishOnReady  Boolean         @default(false)
  uploadedById    String?
  uploadedBySuperAdminId String?
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course          @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  topic           CourseTopic?    @relation(fields: [organizationId, topicId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy      User?           @relation("MediaUploader", fields: [organizationId, uploadedById], references: [organizationId, id], onDelete: Restrict)
  uploadedBySuperAdmin User?      @relation("PlatformMediaUploader", fields: [uploadedBySuperAdminId], references: [id], onDelete: SetNull)
  job             MediaJob?
  watchProgress   WatchProgress[]

  @@unique([organizationId, id])
  @@index([organizationId, deletedAt, status, createdAt])
  @@index([organizationId, courseId, type, status])
  @@index([organizationId, uploadedById, createdAt])
}

model MediaJob {
  id              String         @id @default(cuid())
  organizationId  String
  mediaId         String
  status          MediaJobStatus @default(QUEUED)
  attempts        Int            @default(0)
  progressPercent Int            @default(0)
  error           String?        @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  availableAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media           MediaItem      @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, mediaId])
  @@index([status, availableAt, createdAt])
  @@index([organizationId, status, availableAt])
}

model WatchProgress {
  id                  String       @id @default(cuid())
  organizationId      String
  studentId           String
  mediaId             String
  lastPositionSeconds Float        @default(0)
  watchedSeconds      Float        @default(0)
  completed           Boolean      @default(false)
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student             User         @relation("WatchProgressStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  media               MediaItem    @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, studentId, mediaId])
  @@index([organizationId, mediaId, completed])
}

model ExpertSession {
  id              String              @id @default(cuid())
  organizationId  String
  hostId          String
  batchId         String?
  courseId        String?
  title           String
  description     String
  startsAt        DateTime
  durationMinutes Int
  roomName        String              @unique
  audienceType    String              @default("ALL")
  status          ExpertSessionStatus @default(SCHEDULED)
  freePreview     Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host            User                @relation("ExpertSessionHost", fields: [hostId], references: [id], onDelete: Restrict)
  batch           Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  course          Course?             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  attendances     AttendanceRecord[]

  @@index([organizationId, startsAt])
}

model AttendanceRecord {
  id             String         @id @default(cuid())
  organizationId String
  sessionId      String
  courseId       String?
  studentId      String
  markedById     String?
  status         AttendanceMark
  joinedAt       DateTime?
  markedAt       DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        ExpertSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course         Course?        @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  student        User           @relation("AttendanceStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  markedBy       User?          @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, sessionId, studentId])
  @@index([organizationId, studentId, markedAt])
  @@index([organizationId, courseId, markedAt])
}

model LibraryItem {
  id             String             @id @default(cuid())
  organizationId String
  courseId       String?
  createdById    String
  kind           LibraryKind
  category       String
  title          String
  description    String             @db.Text
  contentText    String?            @db.Text
  externalUrl    String?
  storageKey     String?
  originalName   String?
  mimeType       String?
  published      Boolean            @default(false)
  freePreview    Boolean            @default(false)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course?            @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User               @relation("LibraryCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  savedBy        SavedLibraryItem[]

  @@unique([organizationId, id])
  @@index([organizationId, published, category, kind, updatedAt])
}

model SavedLibraryItem {
  organizationId String
  itemId         String
  studentId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           LibraryItem  @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)
  student        User         @relation(fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, itemId, studentId])
  @@index([organizationId, studentId, createdAt])
}

model Certificate {
  id               String       @id @default(cuid())
  organizationId   String
  courseId         String
  studentId        String
  issuedStudentName String?
  issuedById       String?
  certificateNo    String
  verificationCode String       @unique
  isSample         Boolean      @default(false)
  issuedAt         DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course           Course       @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  student          User         @relation("CertificateStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  issuedBy         User?        @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, certificateNo])
  @@index([organizationId, studentId, issuedAt])
}

model JobOpening {
  id             String           @id @default(cuid())
  organizationId String?
  createdById    String
  title          String
  company        String
  description    String           @db.Text
  externalUrl    String
  postedAt       DateTime         @default(now())
  closesAt       DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("JobOpeningCreator", fields: [createdById], references: [id], onDelete: Restrict)
  applications   JobApplication[]

  @@index([organizationId, isActive, postedAt])
}

model JobApplication {
  id                 String       @id @default(cuid())
  organizationId     String
  jobOpeningId       String
  studentId          String
  resumeStorageKey   String
  resumeOriginalName String
  resumeMimeType     String
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOpening         JobOpening   @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  student            User         @relation("JobApplicationStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, jobOpeningId, studentId])
  @@index([organizationId, studentId, createdAt])
}

model GameRating {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  gameKey        String
  rating         Int
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, studentId, gameKey])
  @@index([organizationId, studentId, updatedAt])
}

model TutorCoursePlan {
  id             String                   @id @default(cuid())
  organizationId String
  tutorId        String
  courseId       String
  period         SubscriptionPeriod
  price          Decimal                  @db.Decimal(12, 2)
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tutor          User                     @relation("TutorCoursePlanTutor", fields: [organizationId, tutorId], references: [organizationId, id], onDelete: Cascade)
  course         Course                   @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  subscriptions  Subscription[]
  payments       Payment[]
  priceHistory   TutorCoursePlanHistory[]

  @@unique([organizationId, id])
  @@unique([organizationId, tutorId, courseId, period])
  @@index([organizationId, courseId, isActive])
  @@index([organizationId, tutorId, isActive])
}

model TutorCoursePlanHistory {
  id             String          @id @default(cuid())
  organizationId String
  planId         String
  changedById    String?
  previousPrice  Decimal?        @db.Decimal(12, 2)
  newPrice       Decimal         @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           TutorCoursePlan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  changedBy      User?           @relation("PaymentPlanPriceChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId, planId, createdAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  studentId          String
  tutorId            String
  courseId           String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  startsAt           DateTime
  endsAt             DateTime
  periodsPaid        Int                @default(1)
  deactivatedBy      String?
  deactivationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student            User               @relation("SubscriptionStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Cascade)
  tutor              User               @relation("SubscriptionTutor", fields: [organizationId, tutorId], references: [organizationId, id], onDelete: Cascade)
  course             Course             @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Cascade)
  plan               TutorCoursePlan    @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  payments           Payment[]

  @@unique([organizationId, id])
  @@unique([organizationId, studentId, tutorId, courseId])
  @@index([organizationId, studentId, status, endsAt])
  @@index([organizationId, courseId, status, endsAt])
  @@index([organizationId, tutorId, status])
}

model Payment {
  id                String              @id @default(cuid())
  organizationId    String
  studentId         String
  tutorId           String
  courseId          String
  planId            String
  subscriptionId    String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  provider          PaymentProviderKind
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus       @default(CREATED)
  periodStart       DateTime
  periodEnd         DateTime
  periodsCount      Int                 @default(1)
  receiptNumber     String?
  createdAt         DateTime            @default(now())
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student           User                @relation("PaymentStudent", fields: [organizationId, studentId], references: [organizationId, id], onDelete: Restrict)
  tutor             User                @relation("PaymentTutor", fields: [organizationId, tutorId], references: [organizationId, id], onDelete: Restrict)
  course            Course              @relation(fields: [organizationId, courseId], references: [organizationId, id], onDelete: Restrict)
  plan              TutorCoursePlan     @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict)
  subscription      Subscription?       @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId, studentId, createdAt])
  @@index([organizationId, tutorId, status, createdAt])
  @@index([organizationId, courseId, status])
}
