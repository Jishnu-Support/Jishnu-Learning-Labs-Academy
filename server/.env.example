NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/jishnu_learning_labs?schema=public
TEST_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/jishnu_learning_labs_test?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SEED_PASSWORD=JishnuDevOnly!2026
REQUIRE_ORG_APPROVAL=false
REQUIRE_ENROLLMENT_APPROVAL=false
SUPER_ADMIN_EMAIL=admin@jishnu.local
SUPER_ADMIN_PASSWORD=JishnuDevOnly!2026
NOTE_STORAGE_DIR=storage/notes
MEDIA_STORAGE_DIR=storage/media
MEDIA_STORAGE_QUOTA_GB=10
MAX_VIDEO_MB=500
MAX_AUDIO_MB=100
KEEP_ORIGINAL_MEDIA=true
MEDIA_PROCESSING_MAX_ATTEMPTS=3
