{
  "projectType": "webapp",
  "setup": [],
  "assertions": [
    {
      "name": "typecheck",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "typecheck"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "lint",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "lint"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "client-build",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--workspace",
        "client"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "server-build",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--workspace",
        "server"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": [
        "test",
        "--workspace",
        "client",
        "--",
        "--maxWorkers=1"
      ],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "server-tests-pass",
      "kind": "process",
      "command": "npm",
      "args": [
        "test",
        "--workspace",
        "server"
      ],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "student-login-route",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": [
        "run",
        "dev:client"
      ],
      "url": "http://localhost:5173/student/login",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "api-health",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": [
        "run",
        "dev:server"
      ],
      "url": "http://localhost:4000/api/health",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 180
    }
  ]
}
